{
  "redirects": [
    {
      "source": "/seo/",
      "destination": "/seo-cyprus/",
      "permanent": true
    },
    {
      "source": "/web-design/",
      "destination": "/web-development-cyprus/",
      "permanent": true
    },
    {
      "source": "/ppc/",
      "destination": "/ppc-agency-cyprus/",
      "permanent": true
    },
    {
      "source": "/social-media/",
      "destination": "/social-media-advertising-solutions/",
      "permanent": true
    },
    {
      "source": "/email-marketing/",
      "destination": "/email-marketing-solutions/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo-file?type=robots"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo-file?type=llms"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-file?type=sitemap"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
